{
  "name": "sinless",
  "version": "0.15.9",
  "private": true,
  "description": "Unofficial Foundry VTT system for the Sinless tabletop RPG",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "check:i18n": "node tools/check-i18n.mjs",
    "lint:syntax": "node tools/check-syntax.mjs",
    "build": "node tools/build.mjs",
    "build:packs": "node tools/packs.mjs",
    "bump": "node tools/bump.mjs",
    "verify": "node tools/verify.mjs",
    "check": "npm test && npm run check:i18n && npm run lint:syntax"
  },
  "license": "MIT",
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.5",
    "classic-level": "^3.0.0"
  }
}
