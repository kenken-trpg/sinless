<div class="sinless-test">
  {{#if notes.length}}<p class="notes">{{#each notes}}<span>{{this}}</span>{{/each}}</p>{{/if}}
  {{#unless simple}}
  <div class="form-group">
    <label>{{localize "SINLESS.Test.pool"}}</label>
    <select name="pool">{{selectOptions poolChoices selected=pool localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "SINLESS.Test.mode"}}</label>
    <select name="mode">{{selectOptions modeChoices selected=mode localize=true}}</select>
  </div>
  {{/unless}}
  {{#if force}}
  <div class="form-group">
    <label data-tooltip="{{localize "SINLESS.Magic.forceHint"}}">{{localize "SINLESS.Magic.force"}}</label>
    <input type="number" name="force" value="{{force.value}}" min="1" max="{{force.max}}">
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{#if rankLabel}}{{rankLabel}}{{else}}{{localize "SINLESS.Test.rank"}}{{/if}}</label>
    <input type="number" name="rank" value="{{rank}}" min="0">
  </div>
  {{#if spec}}
  <div class="form-group">
    <label data-tooltip="{{localize "SINLESS.Spec.hint"}}">{{localize "SINLESS.Spec.label" spec=spec}}</label>
    <input type="checkbox" name="specApplies" {{checked specApplies}}>
  </div>
  {{/if}}
  {{#unless simple}}
  <div class="form-group">
    <label data-tooltip="{{localize "SINLESS.Test.gearHint"}}">{{localize "SINLESS.Test.gear"}}</label>
    <input type="number" name="gear" value="{{gear}}">
  </div>
  {{/unless}}
  {{#if showFiring}}
  <div class="form-group">
    <label>{{localize "SINLESS.Test.firingMode"}}</label>
    <select name="firingMode">{{selectOptions firingChoices selected=firingMode localize=true}}</select>
  </div>
  {{/if}}
  {{#if combat}}
  <fieldset class="combat-modifiers">
    <legend>{{localize "SINLESS.Combat.modifiers"}}</legend>
    <div class="form-group">
      <label>{{localize "SINLESS.Combat.light"}}</label>
      <select name="light">{{selectOptions lightChoices selected="normal" localize=true}}</select>
    </div>
    <div class="form-group">
      <label data-tooltip="{{localize "SINLESS.Combat.coverHint"}}">{{localize "SINLESS.Combat.cover"}}</label>
      <select name="cover">{{selectOptions coverChoices selected="none" localize=true}}</select>
    </div>
    <div class="form-group">
      <label data-tooltip="{{localize "SINLESS.Combat.rangeHint"}}">{{localize "SINLESS.Combat.range"}}{{#if combat.range}} <span class="hint">({{combat.range}})</span>{{/if}}</label>
      <input type="number" name="range" value="0">
    </div>
    <div class="form-group checks">
      <label data-tooltip="{{localize "SINLESS.Combat.pointBlankHint"}}"><input type="checkbox" name="pointBlank"> {{localize "SINLESS.Combat.part.pointBlank"}} +4</label>
      <label data-tooltip="{{localize "SINLESS.Combat.proneHint"}}"><input type="checkbox" name="prone"> {{localize "SINLESS.Combat.part.prone"}} −2</label>
      <label data-tooltip="{{localize "SINLESS.Combat.dualWieldHint"}}"><input type="checkbox" name="dualWield"> {{localize "SINLESS.Combat.part.dualWield"}} −1</label>
    </div>
    <div class="form-group">
      <label data-tooltip="{{localize "SINLESS.Combat.aimHint"}}">{{localize "SINLESS.Combat.aim"}}</label>
      <input type="number" name="aim" value="0" min="0" max="2">
    </div>
    <div class="form-group">
      <label data-tooltip="{{localize "SINLESS.Combat.targetsHint"}}">{{localize "SINLESS.Combat.extraTargets"}}</label>
      <input type="number" name="extraTargets" value="0" min="0">
    </div>
    {{#if combat.recoil}}
    <p class="recoil{{#if recoilJammed}} jammed{{/if}}" data-tooltip="{{localize "SINLESS.Combat.recoilHint"}}">
      {{localize "SINLESS.Combat.recoilStatus" tokens=combat.recoil.tokens capacity=combat.recoil.capacity}}
    </p>
    {{/if}}
  </fieldset>
  {{/if}}
  <div class="form-group">
    <label>{{localize "SINLESS.Test.bonus"}}</label>
    <input type="number" name="bonus" value="{{bonus}}" min="0">
  </div>
  <div class="form-group">
    <label data-tooltip="{{localize "SINLESS.Test.penaltyHint"}}">{{localize "SINLESS.Test.penalty"}}</label>
    <input type="number" name="penalty" value="{{penalty}}" min="0">
  </div>
  {{#unless simple}}
  <div class="form-group">
    <label data-tooltip="{{localize "SINLESS.Test.poolDiceHint"}}">{{localize "SINLESS.Test.poolDice"}}</label>
    <input type="number" name="poolDice" value="" min="0" placeholder="{{localize "SINLESS.Test.max"}}">
  </div>
  {{/unless}}
  {{#if hasKismet}}
  <div class="form-group">
    <label>{{localize "SINLESS.Test.kismet" available=kismetAvailable}}</label>
    <input type="number" name="kismet" value="{{kismet}}" min="0" max="{{kismetAvailable}}">
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{localize "SINLESS.TargetNumber"}}</label>
    <input type="number" name="target" value="{{target}}" min="2" max="6">
  </div>
  <div class="form-group">
    <label>{{localize "SINLESS.Test.reroll"}}</label>
    <select name="reroll">{{selectOptions rerollChoices selected=reroll localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "SINLESS.Test.threshold"}}</label>
    <input type="number" name="threshold" value="{{threshold}}" min="0" placeholder="—">
  </div>
  {{#unless simple}}
  <div class="form-group">
    <label>{{localize "SINLESS.Test.spendPool"}}</label>
    <input type="checkbox" name="spendPool" {{checked spendPool}}>
  </div>
  {{/unless}}
  {{#if autoSuccesses}}<p class="hint">{{localize "SINLESS.Test.autoSuccesses" n=autoSuccesses}}</p>{{/if}}
  <p class="sinless-test-preview"></p>
</div>
