<div class="sinless-damage">
  <p class="notes"><span>{{label}}</span></p>
  <div class="form-group">
    <label>{{localize "SINLESS.Magic.drain"}}</label>
    <input type="number" name="drain" value="{{drain}}" min="0">
  </div>
  <div class="form-group">
    <label data-tooltip="{{localize "SINLESS.Magic.lethalHint"}}">{{localize "SINLESS.Magic.lethal"}}</label>
    <input type="checkbox" name="lethal" {{checked lethal}}>
  </div>
  <div class="form-group">
    <label>{{localize "SINLESS.Magic.channelSuccesses"}}</label>
    <div class="with-button">
      <input type="number" name="channel" value="0" min="0">
      {{#if canRoll}}<button type="button" data-sinless-roll="channel" data-tooltip="{{localize "SINLESS.Magic.rollChannel"}}"><i class="fa-solid fa-dice"></i></button>{{/if}}
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "SINLESS.Damage.soakSuccesses"}}</label>
    <div class="with-button">
      <input type="number" name="soak" value="0" min="0">
      {{#if canRoll}}<button type="button" data-sinless-roll="soak" data-tooltip="{{localize "SINLESS.Damage.rollSoak"}}"><i class="fa-solid fa-dice"></i></button>{{/if}}
    </div>
  </div>
  <p class="sinless-damage-preview sinless-drain-preview"></p>
</div>
