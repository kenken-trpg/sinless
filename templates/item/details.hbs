<section class="item-details">
  {{#if isType.weapon}}
    {{formGroup fields.category value=system.category localize=true}}
    {{formGroup fields.skill value=system.skill choices=skillChoices localize=true}}
    {{formGroup fields.accuracy value=system.accuracy}}
    {{formGroup fields.attackDice value=system.attackDice}}
    {{formGroup fields.damage value=system.damage}}
    {{formGroup fields.penetration value=system.penetration}}
    {{formGroup fields.armorType value=system.armorType localize=true}}
    {{formGroup fields.stun value=system.stun}}
    {{formGroup fields.blast value=system.blast}}
    {{formGroup fields.reach value=system.reach}}
    {{formGroup fields.modes value=system.modes}}
    {{formGroup fields.rangeClose value=system.rangeClose}}
    {{formGroup fields.rangeMax value=system.rangeMax}}
    {{formGroup fields.ammo value=system.ammo}}
    {{formGroup fields.alert value=system.alert}}
  {{/if}}
  {{#if isType.armor}}
    {{formGroup fields.layer value=system.layer localize=true}}
    {{formGroup fields.ballistic value=system.ballistic}}
    {{formGroup fields.impact value=system.impact}}
    {{formGroup fields.equipped value=system.equipped}}
  {{/if}}
  {{#if isType.gear}}
    {{formGroup fields.rating value=system.rating}}
    {{formGroup fields.limitBonus value=system.limitBonus}}
  {{/if}}
  {{#if isType.deck}}
    {{formGroup fields.mcp value=system.mcp}}
    {{formGroup fields.threads value=system.threads}}
    {{formGroup fields.core value=system.core localize=true}}
    {{formGroup fields.io value=system.io}}
    {{formGroup fields.mods value=system.mods}}
    {{formGroup fields.equipped value=system.equipped}}
    {{formGroup fields.nerveRig value=system.nerveRig}}
    {{formGroup fields.cohesion value=system.cohesion}}
  {{/if}}
  {{#if isType.vcr}}
    {{formGroup fields.bonusDice value=system.bonusDice}}
    {{formGroup fields.hardeningBonus value=system.hardeningBonus}}
    {{formGroup fields.links value=system.links}}
    {{formGroup fields.core value=system.core localize=true}}
    {{formGroup fields.mods value=system.mods}}
    {{formGroup fields.zoeticCost value=system.zoeticCost}}
    {{formGroup fields.cost value=system.cost}}
    {{formGroup fields.equipped value=system.equipped}}
    {{formGroup fields.nerveRig value=system.nerveRig}}
  {{/if}}
  {{#if isType.software}}
    {{formGroup fields.rating value=system.rating}}
    {{formGroup fields.skill value=system.skill choices=skillChoices localize=true}}
    {{formGroup fields.action value=system.action localize=true}}
    {{formGroup fields.io value=system.io localize=true}}
    {{formGroup fields.base value=system.base}}
    {{formGroup fields.requiresNan value=system.requiresNan}}
    {{formGroup fields.attack value=system.attack}}
    {{formGroup fields.alert value=system.alert}}
    {{formGroup fields.alertPerSuccess value=system.alertPerSuccess}}
    {{formGroup fields.alertNote value=system.alertNote}}
    {{formGroup fields.reducesAlert value=system.reducesAlert}}
    {{formGroup fields.costPerRating value=system.costPerRating}}
    {{formGroup fields.loaded value=system.loaded}}
    {{formGroup fields.running value=system.running}}
    {{formGroup fields.effect value=system.effect}}
  {{/if}}
  {{#if isType.implant}}
    {{formGroup fields.kind value=system.kind localize=true}}
    {{formGroup fields.rating value=system.rating}}
    {{formGroup fields.zoeticCost value=system.zoeticCost}}
    {{formGroup fields.bodyIndex value=system.bodyIndex}}
    {{formGroup fields.cost value=system.cost}}
    {{formGroup fields.effect value=system.effect}}
  {{/if}}
  {{#if isType.power}}
    {{formGroup fields.category value=system.category localize=true}}
    {{formGroup fields.school value=system.school}}
    {{formGroup fields.force value=system.force}}
    {{#if (eq system.category "amplification")}}
    {{formGroup fields.zoeticCost value=system.zoeticCost}}
    {{else}}
    {{formGroup fields.drain value=system.drain}}
    {{#if (eq system.category "spirit")}}
    {{formGroup fields.spiritBag value=system.spiritBag}}
    {{else}}
    {{formGroup fields.resistPool value=system.resistPool localize=true}}
    {{formGroup fields.resistOptional value=system.resistOptional}}
    {{formGroup fields.damage value=system.damage}}
    {{formGroup fields.damageTrack value=system.damageTrack localize=true}}
    {{formGroup fields.area value=system.area}}
    {{/if}}
    {{formGroup fields.duration value=system.duration}}
    {{formGroup fields.focus value=system.focus}}
    {{formGroup fields.fetish value=system.fetish}}
    {{/if}}
    {{formGroup fields.price value=system.price}}
    {{formGroup fields.effect value=system.effect}}
  {{/if}}
  {{#if isType.ritual}}
    {{formGroup fields.rank value=system.rank}}
    {{formGroup fields.pool value=system.pool localize=true}}
    {{formGroup fields.drain value=system.drain}}
  {{/if}}
  {{#if isType.knowledge}}
    {{formGroup fields.rank value=system.rank}}
  {{/if}}
  {{#if isType.asset}}
    {{formGroup fields.etiquette value=system.etiquette localize=true}}
    {{formGroup fields.free value=system.free}}
    {{formGroup fields.hireCost value=system.hireCost}}
    {{formGroup fields.upkeep value=system.upkeep}}
    {{formGroup fields.operation value=system.operation}}
    {{formGroup fields.sector value=system.sector}}
  {{/if}}
  {{#if isType.resource}}
    {{formGroup fields.resourceType value=system.resourceType}}
    {{formGroup fields.class value=system.class}}
    {{formGroup fields.tags value=system.tags type="checkboxes" localize=true}}
    {{formGroup fields.market value=system.market}}
    {{formGroup fields.marketBonus value=system.marketBonus}}
    {{formGroup fields.upkeep value=system.upkeep}}
    {{formGroup fields.controlled value=system.controlled}}
    {{formGroup fields.damage value=system.damage}}
    {{formGroup fields.influence value=system.influence}}
    {{formGroup fields.demolished value=system.demolished}}
    <fieldset class="brand-bonus">
      <legend>{{localize "SINLESS.Resource.FIELDS.brandBonus.label"}}</legend>
      {{#each config.BRAND_STATS as |label key|}}
      <div class="form-group">
        <label>{{localize label}}</label>
        <input type="number" name="system.brandBonus.{{key}}" value="{{lookup ../system.brandBonus key}}" min="0">
      </div>
      {{/each}}
    </fieldset>
    {{formGroup fields.effect value=system.effect}}
  {{/if}}
  {{#if physical}}
  <fieldset>
    <legend>{{localize "SINLESS.Physical"}}</legend>
    {{formGroup fields.quantity value=system.quantity}}
    {{formGroup fields.weight value=system.weight}}
    {{formGroup fields.cost value=system.cost}}
    {{formGroup fields.carried value=system.carried}}
    {{formGroup fields.metal value=system.metal}}
    {{formGroup fields.concealability value=system.concealability}}
    {{formGroup fields.hardening value=system.hardening}}
  </fieldset>
  {{/if}}
  {{formGroup fields.source value=system.source}}
</section>
