<section class="tab main {{tab.cssClass}}" data-tab="main" data-group="primary">
  {{#if creation}}{{> "systems/sinless/templates/actor/partials/creation-panel.hbs"}}{{/if}}
  {{#if attributes}}
  <div class="attributes">
    {{#each attributes}}
    <div class="attribute">
      <span class="label">{{localize label}}{{#if modified}} <span class="effective" data-tooltip="{{localize "SINLESS.Effect.effective"}}">→ {{value}}</span>{{/if}}</span>
      <input type="number" name="system.attributes.{{key}}.value" value="{{base}}" min="0" data-source-value>
      <span class="slash">/</span>
      <input type="number" class="max" name="system.attributes.{{key}}.max" value="{{max}}" min="0">
    </div>
    {{/each}}
    <div class="attribute charisma-pool">
      <span class="label" data-tooltip="{{localize "SINLESS.Character.FIELDS.charismaPool.hint"}}">{{localize "SINLESS.Character.FIELDS.charismaPool.label"}}</span>
      <select name="system.charismaPool">{{selectOptions charismaPoolChoices selected=system.charismaPool localize=true}}</select>
    </div>
  </div>
  {{/if}}

  <div class="status-row">
    <div class="condition">
      {{#if isEntity}}
      {{> "systems/sinless/templates/actor/partials/condition-track.hbs" track="stun" label="SINLESS.Grid.cohesion" boxes=stunBoxes}}
      {{else}}
      {{> "systems/sinless/templates/actor/partials/condition-track.hbs" track="physical" label="SINLESS.Condition.physical" boxes=physicalBoxes}}
      {{> "systems/sinless/templates/actor/partials/condition-track.hbs" track="stun" label="SINLESS.Condition.stun" boxes=stunBoxes}}
      {{/if}}
      <div class="condition-footer">
        <label>{{localize "SINLESS.Condition.overflow"}}
          <input type="number" name="system.condition.overflow" value="{{system.condition.overflow}}" min="0">
        </label>
        <span class="penalty" data-tooltip="{{localize "SINLESS.Condition.penaltyHint"}}">
          {{localize "SINLESS.Condition.penalty"}}: <strong>{{#if system.totalPenalty}}−{{system.totalPenalty}}{{else}}0{{/if}}</strong>
        </span>
        <label data-tooltip="{{localize "SINLESS.Actor.FIELDS.penalty.hint"}}">{{localize "SINLESS.Actor.FIELDS.penalty.label"}}
          <input type="number" name="system.penalty" value="{{system.penalty}}" min="0">
        </label>
      </div>
      {{#with conditionStatus}}
      <div class="condition-status">
        {{#if dead}}<p class="warn"><i class="fa-solid fa-skull"></i> {{localize "SINLESS.Overload.dead"}}</p>
        {{else}}
        {{#if unconscious}}<p class="warn"><i class="fa-solid fa-bed"></i> {{localize "SINLESS.Overload.unconscious"}}</p>{{/if}}
        {{#if dying}}
        <p class="warn"><i class="fa-solid fa-droplet"></i> {{localize "SINLESS.Overload.dying" n=bleedOut}}
          <button type="button" data-action="stabilizeDying" data-tooltip="{{localize "SINLESS.Overload.stabilizeHint"}}"><i class="fa-solid fa-kit-medical"></i> {{localize "SINLESS.Overload.stabilize"}}</button>
        </p>
        {{/if}}
        {{#if tests.length}}{{#unless unconscious}}
        <p class="warn">{{localize "SINLESS.Overload.restricted"}}</p>
        {{#each tests}}
        <button type="button" data-action="rollOverload" data-track="{{track}}"><i class="fa-solid fa-heart-pulse"></i> {{localize label}} ({{localize "SINLESS.Overload.needed" n=needed}})</button>
        {{/each}}
        {{/unless}}{{/if}}
        {{/if}}
        {{#if overflow}}
        <button type="button" data-action="rollPermanentInjury" data-tooltip="{{localize "SINLESS.Injury.hint"}}"><i class="fa-solid fa-user-injured"></i> {{localize "SINLESS.Injury.title"}}</button>
        {{/if}}
      </div>
      {{/with}}
    </div>
    <div class="defenses">
      <div class="armor">
        <span>{{localize "SINLESS.Armor.ballistic"}} <strong>{{system.armor.ballistic.total}}</strong> ({{system.armor.ballistic.highest}})</span>
        <span>{{localize "SINLESS.Armor.impact"}} <strong>{{system.armor.impact.total}}</strong> ({{system.armor.impact.highest}})</span>
      </div>
      {{#if system.combat}}
      <div class="recoil{{#if recoilJammed}} jammed{{/if}}" data-tooltip="{{localize "SINLESS.Combat.recoilHint"}}">
        <label>{{localize "SINLESS.Combat.recoil"}}
          <input type="number" name="system.combat.recoil" value="{{system.combat.recoil}}" min="0">
          / {{system.combat.recoilCapacity}}
        </label>
        <button type="button" class="stabilize" data-action="stabilize" data-tooltip="{{localize "SINLESS.Combat.stabilize"}}: {{localize "SINLESS.Combat.stabilizeHint"}}" aria-label="{{localize "SINLESS.Combat.stabilize"}}"><i class="fa-solid fa-crosshairs"></i></button>
      </div>
      {{/if}}
      {{#each defenses}}
      <div class="defense-row">
        <button type="button" class="defense" data-action="rollDefense" data-defense="{{key}}">
          <i class="fa-solid fa-shield-halved"></i> {{localize label}}
        </button>
        {{#if ../hasFixedDefenses}}
        <input type="number" class="fixed-defense" name="system.defenses.{{key}}" value="{{fixed}}" min="0"
          placeholder="{{poolLabel}}" data-tooltip="{{localize "SINLESS.Npc.FIELDS.defenses.hint"}}">
        {{/if}}
      </div>
      {{/each}}
      <button type="button" class="refresh" data-action="refreshPools"><i class="fa-solid fa-rotate"></i> {{localize "SINLESS.RefreshPools"}}</button>
    </div>
  </div>

  <div class="pools">
    {{#each pools}}
    <div class="pool pool-{{key}}">
      <header>
        <a class="pool-name" data-action="rollPool" data-pool="{{key}}" data-tooltip="{{localize "SINLESS.RollPool"}}">{{localize label}}</a>
        <span class="pool-value"><strong>{{value}}</strong> / {{max}}</span>
        {{#if ../system.poolMax}}
        <input type="number" class="pool-max" name="system.poolMax.{{key}}" value="{{lookup ../system.poolMax key}}" min="0" data-tooltip="{{localize "SINLESS.Npc.FIELDS.poolMax.label"}}">
        {{/if}}
        <input type="number" class="pool-spent" name="system.pools.{{key}}.spent" value="{{spent}}" min="0" data-tooltip="{{localize "SINLESS.PoolSpent"}}">
      </header>
      <ol class="skills">
        {{#each skills}}
        <li class="skill{{#if trainedOnly}} trained-only{{/if}}{{#unless rank}} unranked{{/unless}}">
          <a class="skill-name" data-action="rollSkill" data-skill="{{key}}"{{#if group}} data-tooltip="{{group}}"{{/if}}>{{label}}{{#if trainedOnly}}*{{/if}}</a>
          <input type="text" class="spec" name="system.skills.{{key}}.spec" value="{{spec}}" placeholder="{{localize "SINLESS.Specialization"}}">
          <input type="number" class="rank" name="system.skills.{{key}}.rank" value="{{rank}}" min="0">
        </li>
        {{/each}}
      </ol>
    </div>
    {{/each}}
  </div>
</section>
