<header class="sheet-header">
  <img class="profile" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage" data-tooltip="{{actor.name}}">
  <div class="header-fields">
    <input class="actor-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize "SINLESS.Name"}}">
    <div class="header-grid">
      <label>{{localize "SINLESS.Vehicle.FIELDS.kind.label"}}
        <select name="system.kind">{{selectOptions kindChoices selected=system.kind localize=true}}</select>
      </label>
      <label>{{localize "SINLESS.Vehicle.FIELDS.frame.label"}}
        <select name="system.frame">{{selectOptions frameChoices selected=system.frame localize=true}}</select>
      </label>
      <label>{{localize "SINLESS.Vehicle.FIELDS.mobility.label"}}
        <select name="system.mobility">{{selectOptions mobilityChoices selected=system.mobility localize=true}}</select>
      </label>
      <label>{{localize "SINLESS.Vehicle.FIELDS.cost.label"}}
        <input type="number" name="system.cost" value="{{system.cost}}" min="0">
      </label>
    </div>
  </div>
  <div class="header-stats">
    <div class="stat">
      <span class="label">{{localize "SINLESS.TargetNumber"}}</span>
      <span class="value">{{targetNumber}}+</span>
    </div>
  </div>
</header>
