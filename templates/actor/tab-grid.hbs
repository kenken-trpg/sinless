<section class="tab grid {{tab.cssClass}}" data-tab="grid" data-group="primary">
  {{#if grid.network}}
  <div class="network-panel">
    <header>
      <h3>{{localize "SINLESS.Digital.entityTitle"}}</h3>
      <label class="checkbox" data-tooltip="{{localize "SINLESS.Npc.FIELDS.network.entity.hint"}}">
        <input type="checkbox" name="system.network.entity" {{checked grid.network.entity}}> {{localize "SINLESS.Npc.FIELDS.network.entity.label"}}
      </label>
    </header>
    <div class="network-fields">
      <label>{{localize "SINLESS.Npc.FIELDS.network.hardening.label"}} <input type="number" name="system.network.hardening" value="{{grid.network.hardening}}" min="0"></label>
      <label data-tooltip="{{localize "SINLESS.Npc.FIELDS.network.alertAura.hint"}}">{{localize "SINLESS.Npc.FIELDS.network.alertAura.label"}} <input type="number" name="system.network.alertAura" value="{{grid.network.alertAura}}" min="0"></label>
      <label data-tooltip="{{localize "SINLESS.Npc.FIELDS.network.shrinkDice.hint"}}">{{localize "SINLESS.Npc.FIELDS.network.shrinkDice.label"}} <input type="number" name="system.network.shrinkDice" value="{{grid.network.shrinkDice}}" min="0"></label>
      <label>{{localize "SINLESS.Npc.FIELDS.network.shrinkMeters.label"}} <input type="number" name="system.network.shrinkMeters" value="{{grid.network.shrinkMeters}}" min="0"> m</label>
    </div>
    {{#if grid.network.entity}}<p class="hint">{{localize "SINLESS.Digital.entityHint"}}</p>{{/if}}
    {{#if grid.network.shrinkDice}}
    <div class="hack-buttons">
      <button type="button" data-action="rollShrink"><i class="fa-solid fa-compress"></i> {{localize "SINLESS.Digital.shrinkButton" n=grid.network.shrinkDice}}</button>
    </div>
    {{/if}}
  </div>
  {{/if}}
  <div class="grid-status">
    <div class="grid-box">
      <span class="label">{{localize "SINLESS.Grid.intrusion"}}</span>
      <strong>{{localize grid.intrusionLabel}}</strong>{{#if grid.intrusionPenalty}} <span class="penalty">−{{grid.intrusionPenalty}}</span>{{/if}}
    </div>
    <div class="grid-box">
      <span class="label">{{localize "SINLESS.Grid.alert"}}</span>
      {{#if isGM}}<a data-action="adjustAlert" data-delta="-1" data-tooltip="{{localize "SINLESS.Decrease" name=(localize "SINLESS.Grid.alert")}}" aria-label="{{localize "SINLESS.Decrease" name=(localize "SINLESS.Grid.alert")}}"><i class="fa-solid fa-minus"></i></a>{{/if}}
      <strong>{{grid.alert}}</strong>
      {{#if isGM}}<a data-action="adjustAlert" data-delta="1" data-tooltip="{{localize "SINLESS.Increase" name=(localize "SINLESS.Grid.alert")}}" aria-label="{{localize "SINLESS.Increase" name=(localize "SINLESS.Grid.alert")}}"><i class="fa-solid fa-plus"></i></a>{{/if}}
    </div>
    <div class="grid-box">
      <span class="label">{{localize "SINLESS.Grid.influence"}}</span>
      <input type="number" name="system.grid.influence" value="{{grid.influence}}" min="0"> m
      {{#if grid.influencePenalty}}<span class="penalty" data-tooltip="{{localize "SINLESS.Grid.rangePenaltyHint"}}">−{{grid.influencePenalty}}</span>{{/if}}
      <a data-action="resetInfluence" data-tooltip="{{localize "SINLESS.Grid.resetInfluence"}}" aria-label="{{localize "SINLESS.Grid.resetInfluence"}}"><i class="fa-solid fa-rotate-left"></i></a>
    </div>
  </div>

  {{#if grid.deck}}
  <div class="deck-panel">
    <header>
      <h3>{{grid.deck.name}}</h3>
      <span class="mcp" data-tooltip="{{localize "SINLESS.Grid.mcpHint"}}">{{localize "SINLESS.Grid.mcpDice"}} <strong>{{grid.mcp.value}}</strong> / {{grid.mcp.max}}</span>
    </header>
    <div class="deck-stats">
      <span>{{localize "SINLESS.Item.FIELDS.hardening.label"}} <strong>{{grid.deck.system.hardening}}</strong></span>
      <span>{{localize "SINLESS.Item.FIELDS.threads.label"}} <strong>{{grid.loaded}}</strong> / {{grid.deck.system.threads}}</span>
      <span>{{localize "SINLESS.Item.FIELDS.core.label"}} <strong>{{localize grid.coreLabel}}</strong></span>
      <span>I/O <strong>{{grid.running}}</strong> / {{grid.deck.system.io}}</span>
      <span>{{#if grid.deck.system.nerveRig}}{{localize "SINLESS.Item.FIELDS.nerveRig.label"}}{{else}}<span class="penalty">{{localize "SINLESS.Grid.noNerveRig"}} −2</span>{{/if}}</span>
    </div>
    <div class="track track-cohesion">
      <span class="track-label">{{localize "SINLESS.Grid.cohesion"}}</span>
      <div class="boxes">
        {{#each grid.cohesionBoxes}}<a class="box{{#if filled}} filled{{/if}}{{#if mark}} mark{{/if}}" data-action="setCohesion" data-n="{{n}}">{{#if mark}}<span>-1</span>{{/if}}</a>{{/each}}
      </div>
    </div>
    {{#if grid.issues.length}}<ul class="issues">{{#each grid.issues}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    <div class="hack-buttons">
      <button type="button" data-action="rollNanHack" data-mode="device" {{#unless grid.hasProgram}}disabled{{/unless}}><i class="fa-solid fa-plug-circle-bolt"></i> {{localize "SINLESS.Grid.hack.device"}}</button>
      <button type="button" data-action="rollNanHack" data-mode="brute" {{#unless grid.hasProgram}}disabled{{/unless}}><i class="fa-solid fa-hammer"></i> {{localize "SINLESS.Grid.hack.brute"}}</button>
      <button type="button" data-action="rollNanHack" data-mode="stealth" {{#unless grid.hasProgram}}disabled{{/unless}}><i class="fa-solid fa-user-secret"></i> {{localize "SINLESS.Grid.hack.stealth"}}</button>
    </div>
  </div>
  {{else}}
  {{#unless grid.network.entity}}<p class="hint">{{localize "SINLESS.Grid.noDeckHint"}}</p>{{/unless}}
  {{/if}}

  {{#if rig}}
  <div class="rig-panel">
    <header>
      <h3>{{#if rig.vcr}}{{rig.vcr.name}}{{else}}{{localize "SINLESS.Rig.title"}}{{/if}}</h3>
      {{#if rig.vcr}}<span data-tooltip="{{localize "SINLESS.Rig.bonusHint"}}">{{localize "SINLESS.Rig.bonusDice"}} <strong>{{rig.bonus.value}}</strong> / {{rig.bonus.max}}</span>{{/if}}
    </header>
    {{#if rig.vcr}}
    <div class="deck-stats">
      <span>{{localize "SINLESS.Item.FIELDS.links.label"}} <strong class="{{#if rig.overLinks}}penalty{{/if}}">{{rig.vehicles.length}}</strong> / {{rig.vcr.system.links}}</span>
      <span>{{localize "SINLESS.Item.FIELDS.hardeningBonus.label"}} <strong>+{{rig.vcr.system.hardeningBonus}}</strong></span>
      <span>{{localize "SINLESS.Item.FIELDS.core.label"}} <strong>{{localize rig.coreLabel}}</strong></span>
      <span>{{#if rig.vcr.system.nerveRig}}{{localize "SINLESS.Item.FIELDS.nerveRig.label"}}{{else}}{{localize "SINLESS.Grid.noNerveRig"}}{{/if}}</span>
    </div>
    {{/if}}
    <ul class="vehicles">
      {{#each rig.vehicles}}
      <li data-vehicle-id="{{id}}"><img src="{{img}}" alt=""><a data-action="openVehicle">{{name}}</a> <span class="item-summary">{{localize control}}</span></li>
      {{else}}
      <li class="hint">{{localize "SINLESS.Rig.noVehicles"}}</li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

  {{#each groups}}
  {{> "systems/sinless/templates/actor/partials/item-list.hbs" this}}
  {{/each}}
</section>
