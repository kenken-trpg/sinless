<section class="item-group" data-type="{{type}}">
  <header class="item-group-header">
    <h3>{{localize label}}</h3>
    {{#if @root.editable}}
    <button type="button" class="icon" data-action="itemCreate" data-type="{{type}}" data-tooltip="{{localize "SINLESS.ItemCreate"}}"><i class="fa-solid fa-plus"></i></button>
    {{/if}}
  </header>
  <ol class="item-list">
    {{#each items as |item|}}
    <li class="item draggable" data-item-id="{{item.id}}">
      <img src="{{item.img}}" alt="" class="item-img" data-action="rollItem">
      <a class="item-name" data-action="rollItem">{{item.name}}</a>
      <span class="item-summary">
        {{#if (eq item.type "weapon")}}{{localize "SINLESS.Item.FIELDS.accuracy.label"}} {{item.system.accuracy}} · {{localize "SINLESS.Item.FIELDS.damage.label"}} {{item.system.damage}} · {{localize "SINLESS.Item.FIELDS.penetration.label"}} {{item.system.penetration}}{{/if}}
        {{#if (eq item.type "armor")}}{{localize "SINLESS.Armor.ballistic"}} {{item.system.ballistic}} / {{localize "SINLESS.Armor.impact"}} {{item.system.impact}}{{/if}}
        {{#if (eq item.type "implant")}}ZC {{item.system.zoeticCost}}{{#if item.system.bodyIndex}} · BI {{item.system.bodyIndex}}{{/if}}{{/if}}
        {{#if (eq item.type "power")}}{{localize "SINLESS.Item.FIELDS.force.label"}} {{item.system.force}}{{/if}}
        {{#if (eq item.type "ritual")}}{{localize "SINLESS.Item.FIELDS.rank.label"}} {{item.system.rank}}{{/if}}
        {{#if (eq item.type "knowledge")}}{{localize "SINLESS.Item.FIELDS.rank.label"}} {{item.system.rank}}{{/if}}
        {{#if (eq item.type "asset")}}{{localize (lookup @root.config.ETIQUETTES item.system.etiquette)}}{{/if}}
        {{#if (eq item.type "gear")}}{{#if item.system.rating}}{{localize "SINLESS.Item.FIELDS.rating.label"}} {{item.system.rating}}{{/if}}{{/if}}
      </span>
      <span class="item-controls">
        {{#if (eq item.type "armor")}}
        <a data-action="itemToggle" data-field="equipped" class="{{#if item.system.equipped}}active{{/if}}" data-tooltip="{{localize "SINLESS.Item.FIELDS.equipped.label"}}"><i class="fa-solid fa-shirt"></i></a>
        {{/if}}
        {{#if (ne item.system.carried undefined)}}
        <a data-action="itemToggle" data-field="carried" class="{{#if item.system.carried}}active{{/if}}" data-tooltip="{{localize "SINLESS.Item.FIELDS.carried.label"}}"><i class="fa-solid fa-suitcase"></i></a>
        {{/if}}
        <a data-action="itemEdit" data-tooltip="{{localize "SINLESS.ItemEdit"}}"><i class="fa-solid fa-pen-to-square"></i></a>
        {{#if @root.editable}}<a data-action="itemDelete" data-tooltip="{{localize "SINLESS.ItemDelete"}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
      </span>
    </li>
    {{/each}}
  </ol>
</section>
