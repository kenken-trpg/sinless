<section class="item-group" data-type="{{type}}">
  <header class="item-group-header">
    <h3>{{localize label}}</h3>
    {{#if @root.editable}}
    <button type="button" class="icon" data-action="itemCreate" data-type="{{type}}" data-tooltip="{{localize "SINLESS.ItemCreate"}}" aria-label="{{localize "SINLESS.ItemCreate"}}"><i class="fa-solid fa-plus"></i></button>
    {{/if}}
  </header>
  <ol class="item-list">
    {{#each items as |item|}}
    <li class="item draggable" data-item-id="{{item.id}}">
      <img src="{{item.img}}" alt="" class="item-img" data-action="rollItem">
      <a class="item-name" data-action="rollItem">{{item.name}}</a>
      <span class="item-summary">
        {{#if (eq item.type "weapon")}}{{localize "SINLESS.Item.FIELDS.accuracy.label"}} {{item.system.accuracy}} · {{localize "SINLESS.Item.FIELDS.damage.label"}} {{item.system.damage}} · {{localize "SINLESS.Item.FIELDS.penetration.label"}} {{item.system.penetration}}{{/if}}
        {{#if (eq item.type "armor")}}{{localize "SINLESS.Armor.ballistic"}} {{item.system.ballistic}} / {{localize "SINLESS.Armor.impact"}} {{item.system.impact}}{{/if}}
        {{#if (eq item.type "implant")}}ZC {{item.system.zoeticCost}}{{#if item.system.bodyIndex}} · BI {{item.system.bodyIndex}}{{/if}}{{/if}}
        {{#if (eq item.type "power")}}{{localize (lookup @root.config.POWER_CATEGORIES item.system.category)}}{{#unless (eq item.system.category "amplification")}} · {{localize "SINLESS.Item.FIELDS.force.label"}} {{item.system.force}}{{/unless}}{{#if item.system.drain}} · {{localize "SINLESS.Magic.drain"}} {{item.system.drain}}{{/if}}{{#if (eq item.system.category "amplification")}} · ZC {{item.system.zoeticCost}}{{/if}}{{/if}}
        {{#if (eq item.type "ritual")}}{{localize "SINLESS.Item.FIELDS.rank.label"}} {{item.system.rank}}{{/if}}
        {{#if (eq item.type "knowledge")}}{{localize "SINLESS.Item.FIELDS.rank.label"}} {{item.system.rank}}{{/if}}
        {{#if (eq item.type "asset")}}{{localize (lookup @root.config.ETIQUETTES item.system.etiquette)}}{{/if}}
        {{#if (eq item.type "deck")}}MCP {{item.system.mcp}} · {{localize "SINLESS.Item.FIELDS.threads.label"}} {{item.system.threads}} · I/O {{item.system.io}}{{/if}}
        {{#if (eq item.type "software")}}{{localize "SINLESS.Item.FIELDS.rating.label"}} {{item.system.rating}}{{#if item.system.base}} · {{localize "SINLESS.Item.FIELDS.base.label"}}{{/if}}{{#if item.system.requiresNan}} · NAN{{/if}}{{/if}}
        {{#if (eq item.type "vcr")}}{{localize "SINLESS.Rig.bonusDice"}} {{item.system.bonusDice}} · {{localize "SINLESS.Item.FIELDS.links.label"}} {{item.system.links}}{{/if}}
        {{#if (eq item.type "gear")}}{{#if item.system.rating}}{{localize "SINLESS.Item.FIELDS.rating.label"}} {{item.system.rating}}{{/if}}{{/if}}
      </span>
      <span class="item-controls">
        {{#if (eq item.type "power")}}{{#if (eq item.system.category "spirit")}}
        <a data-action="invokeSpirit" data-tooltip="{{localize "SINLESS.Magic.invokeHint"}}" aria-label="{{localize "SINLESS.Magic.invokeHint"}}"><i class="fa-solid fa-ghost"></i></a>
        {{/if}}{{/if}}
        {{#if (eq item.type "software")}}{{#unless item.system.base}}
        <a data-action="itemToggle" data-field="loaded" class="{{#if item.system.loaded}}active{{/if}}" data-tooltip="{{localize "SINLESS.Item.FIELDS.loaded.label"}}" aria-label="{{localize "SINLESS.Item.FIELDS.loaded.label"}}"><i class="fa-solid fa-layer-group"></i></a>
        <a data-action="itemToggle" data-field="running" class="{{#if item.system.running}}active{{/if}}" data-tooltip="{{localize "SINLESS.Item.FIELDS.running.label"}}" aria-label="{{localize "SINLESS.Item.FIELDS.running.label"}}"><i class="fa-solid fa-microchip"></i></a>
        {{/unless}}{{/if}}
        {{#if (or (eq item.type "deck") (eq item.type "vcr"))}}
        <a data-action="itemToggle" data-field="equipped" class="{{#if item.system.equipped}}active{{/if}}" data-tooltip="{{localize "SINLESS.Item.FIELDS.equipped.label"}}" aria-label="{{localize "SINLESS.Item.FIELDS.equipped.label"}}"><i class="fa-solid fa-plug"></i></a>
        {{/if}}
        {{#if (eq item.type "armor")}}
        <a data-action="itemToggle" data-field="equipped" class="{{#if item.system.equipped}}active{{/if}}" data-tooltip="{{localize "SINLESS.Item.FIELDS.equipped.label"}}" aria-label="{{localize "SINLESS.Item.FIELDS.equipped.label"}}"><i class="fa-solid fa-shirt"></i></a>
        {{/if}}
        {{#if (ne item.system.carried undefined)}}
        <a data-action="itemToggle" data-field="carried" class="{{#if item.system.carried}}active{{/if}}" data-tooltip="{{localize "SINLESS.Item.FIELDS.carried.label"}}" aria-label="{{localize "SINLESS.Item.FIELDS.carried.label"}}"><i class="fa-solid fa-suitcase"></i></a>
        {{/if}}
        <a data-action="itemEdit" data-tooltip="{{localize "SINLESS.ItemEdit"}}" aria-label="{{localize "SINLESS.ItemEdit"}}"><i class="fa-solid fa-pen-to-square"></i></a>
        {{#if @root.editable}}<a data-action="itemDelete" data-tooltip="{{localize "SINLESS.ItemDelete"}}" aria-label="{{localize "SINLESS.ItemDelete"}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
      </span>
    </li>
    {{/each}}
  </ol>
</section>
