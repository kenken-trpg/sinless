<div class="track track-{{track}}">
  <span class="track-label">{{localize label}}</span>
  <div class="boxes">
    {{#each boxes}}
    <a class="box{{#if filled}} filled{{/if}}{{#if mark}} mark{{/if}}" data-action="setCondition" data-track="{{../track}}" data-n="{{n}}">{{#if mark}}<span>-1</span>{{/if}}</a>
    {{/each}}
  </div>
</div>
