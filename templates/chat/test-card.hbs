<div class="sinless-card{{#if abf}} abf{{/if}}">
  <header class="card-header">
    <h3>{{label}}</h3>
    <span class="tn">{{localize "SINLESS.TargetNumber"}} {{target}}+</span>
  </header>
  {{#if notes.length}}<p class="notes">{{#each notes}}<span>{{this}}</span>{{/each}}</p>{{/if}}
  {{#if plan.usesPool}}
  <p class="breakdown">{{localize "SINLESS.Card.breakdown" pool=plan.poolDice bonus=plan.bonusDice kismet=plan.kismetDice}}</p>
  {{else}}
  <p class="breakdown">{{localize "SINLESS.Card.dice" n=plan.total}}</p>
  {{/if}}
  <ol class="dice">
    {{#each initialDice}}<li class="die{{#if success}} success{{/if}}{{#if one}} one{{/if}}{{#if rerolled}} rerolled{{/if}}">{{value}}</li>{{/each}}
  </ol>
  {{#if rerollCancelled}}<p class="reroll-note">{{localize "SINLESS.Card.rerollCancelled"}}</p>{{/if}}
  {{#if finalDice}}
  <p class="reroll-note">{{localize "SINLESS.Card.afterReroll"}}</p>
  <ol class="dice">
    {{#each finalDice}}<li class="die{{#if success}} success{{/if}}{{#if one}} one{{/if}}">{{value}}</li>{{/each}}
  </ol>
  {{/if}}
  {{#if kismetDice.length}}
  <p class="reroll-note">{{localize "SINLESS.Card.kismetAdded"}}</p>
  <ol class="dice">
    {{#each kismetDice}}<li class="die kismet{{#if success}} success{{/if}}">{{value}}</li>{{/each}}
  </ol>
  {{/if}}
  <div class="result">
    {{#if untrained}}<span class="untrained">{{localize "SINLESS.Card.untrained" raw=sum.raw}}</span>{{/if}}
    {{#if autoSuccesses}}<span class="auto">{{localize "SINLESS.Card.autoSuccesses" n=autoSuccesses}}</span>{{/if}}
    <span class="successes">{{localize "SINLESS.Card.successes" n=sum.successes}}</span>
    {{#if (eq sum.outcome "abf")}}<strong class="outcome abf">{{localize "SINLESS.ABF"}}</strong>{{/if}}
    {{#if (eq sum.outcome "success")}}<strong class="outcome success">{{localize "SINLESS.Card.success" threshold=threshold}}</strong>{{/if}}
    {{#if (eq sum.outcome "failure")}}<strong class="outcome failure">{{localize "SINLESS.Card.failure" threshold=threshold}}</strong>{{/if}}
  </div>
  {{#if mcpUsed}}<p class="reroll-note">{{localize "SINLESS.Grid.mcpUsed" n=mcpUsed}}</p>{{/if}}
  {{#if extra.effect}}<p class="effect">{{extra.effect}}</p>{{/if}}
  {{#if grid}}
  <div class="grid-result">
    {{#if grid.nan}}<p>{{localize "SINLESS.Grid.influenceGain" n=grid.gain}}</p>{{/if}}
    <p>{{localize "SINLESS.Grid.alertRaise" n=grid.alert}}{{#if extra.alertNote}} <span class="formula">({{extra.alertNote}})</span>{{/if}}{{#if extra.shadow}} <span class="formula">{{localize "SINLESS.Grid.shadowReduced" n=extra.shadow}}</span>{{/if}}</p>
    {{#if extra.alertApplied}}<p class="effect">{{localize "SINLESS.Grid.alertNow" n=extra.alertNow}}</p>{{/if}}
    {{#if grid.nan}}{{#unless extra.influenceApplied}}{{#if grid.gain}}
    <button type="button" data-sinless-action="apply-influence"><i class="fa-solid fa-tower-broadcast"></i> {{localize "SINLESS.Grid.applyInfluence" n=grid.gain}}</button>
    {{/if}}{{/unless}}{{/if}}
    {{#unless extra.alertApplied}}{{#if grid.alert}}
    <button type="button" data-sinless-action="apply-alert"><i class="fa-solid fa-bell"></i> {{localize "SINLESS.Grid.applyAlert" n=grid.alert}}</button>
    {{/if}}{{/unless}}
  </div>
  {{/if}}
  {{#if extra.heatRaised}}<p class="effect warn">{{localize "SINLESS.Card.heatRaised" heat=extra.heatRaised}}</p>{{/if}}
  {{#if extra.weapon}}
  <p class="weapon-line">
    {{#if extra.blast}}{{localize "SINLESS.Card.damageBlast" damage=extra.damage}}{{else}}{{localize "SINLESS.Card.damage" damage=extra.damage}}{{/if}}
    · {{localize (concat "SINLESS.Armor." extra.armorType)}} · {{localize "SINLESS.Item.FIELDS.penetration.label"}} {{extra.penetration}}
    {{#if extra.stun}} · {{localize "SINLESS.Condition.stun"}}{{/if}}
    {{#if extra.damageFormula}}<span class="formula">({{extra.damageText}} → {{extra.damageFormula}})</span>{{/if}}
    {{#if extra.damageNote}}<span class="formula">+ {{extra.damageNote}}</span>{{/if}}
  </p>
  {{#if canDefend}}
  <div class="defend">
    {{#each extra.targets}}
    <button type="button" data-sinless-action="defend" data-target-uuid="{{uuid}}"><i class="fa-solid fa-shield-halved"></i> {{localize "SINLESS.Card.defend" name=name}}</button>
    {{/each}}
    <button type="button" data-sinless-action="defend-selected"><i class="fa-solid fa-crosshairs"></i> {{localize "SINLESS.Card.defendSelected"}}</button>
  </div>
  {{/if}}
  {{/if}}
  {{#if canAddKismet}}
  <button type="button" data-sinless-action="kismet"><i class="fa-solid fa-dice-d6"></i> {{localize "SINLESS.Card.addKismet"}}</button>
  {{/if}}
</div>
