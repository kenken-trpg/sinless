<div class="sinless-card{{#if abf}} abf{{/if}}">
  <header class="card-header">
    <h3>{{label}}</h3>
    <span class="tn">{{localize "SINLESS.TargetNumber"}} {{target}}+</span>
  </header>
  {{#if notes.length}}<p class="notes">{{#each notes}}<span>{{this}}</span>{{/each}}</p>{{/if}}
  {{#if plan.usesPool}}
  <p class="breakdown">{{localize "SINLESS.Card.breakdown" pool=plan.poolDice bonus=plan.bonusDice kismet=plan.kismetDice}}</p>
  {{else}}
  <p class="breakdown">{{localize "SINLESS.Card.dice" n=plan.total}}</p>
  {{/if}}
  <ol class="dice">
    {{#each initialDice}}<li class="die{{#if success}} success{{/if}}{{#if one}} one{{/if}}{{#if rerolled}} rerolled{{/if}}">{{value}}{{#if success}}<span class="sinless-sr-only">({{localize "SINLESS.Accessibility.dieSuccess"}})</span>{{/if}}{{#if rerolled}}<span class="sinless-sr-only">({{localize "SINLESS.Accessibility.dieRerolled"}})</span>{{/if}}</li>{{/each}}
  </ol>
  {{#if rerollCancelled}}<p class="reroll-note">{{localize "SINLESS.Card.rerollCancelled"}}</p>{{/if}}
  {{#if finalDice}}
  <p class="reroll-note">{{localize "SINLESS.Card.afterReroll"}}</p>
  <ol class="dice">
    {{#each finalDice}}<li class="die{{#if success}} success{{/if}}{{#if one}} one{{/if}}">{{value}}{{#if success}}<span class="sinless-sr-only">({{localize "SINLESS.Accessibility.dieSuccess"}})</span>{{/if}}</li>{{/each}}
  </ol>
  {{/if}}
  {{#if kismetDice.length}}
  <p class="reroll-note">{{localize "SINLESS.Card.kismetAdded"}}</p>
  <ol class="dice">
    {{#each kismetDice}}<li class="die kismet{{#if success}} success{{/if}}">{{value}}{{#if success}}<span class="sinless-sr-only">({{localize "SINLESS.Accessibility.dieSuccess"}})</span>{{/if}}</li>{{/each}}
  </ol>
  {{/if}}
  <div class="result">
    {{#if untrained}}<span class="untrained">{{localize "SINLESS.Card.untrained" raw=sum.raw}}</span>{{/if}}
    {{#if autoSuccesses}}<span class="auto">{{localize "SINLESS.Card.autoSuccesses" n=autoSuccesses}}</span>{{/if}}
    <span class="successes">{{localize "SINLESS.Card.successes" n=sum.successes}}</span>
    {{#if (eq sum.outcome "abf")}}<strong class="outcome abf">{{localize "SINLESS.ABF"}}</strong>{{/if}}
    {{#if (eq sum.outcome "success")}}<strong class="outcome success">{{localize "SINLESS.Card.success" threshold=threshold}}</strong>{{/if}}
    {{#if (eq sum.outcome "failure")}}<strong class="outcome failure">{{localize "SINLESS.Card.failure" threshold=threshold}}</strong>{{/if}}
  </div>
  {{#if wardCrossed}}<p class="effect warn">{{localize "SINLESS.Ward.crossedLine" n=wardCrossed}}</p>{{/if}}
  {{#if shatter}}<p class="effect{{#unless shatter.destroyed}} warn{{/unless}}">{{#if shatter.destroyed}}{{localize "SINLESS.Ward.destroyed" n=shatter.from}}{{else}}{{localize "SINLESS.Ward.weakened" from=shatter.from to=shatter.ward}}{{/if}}</p>{{/if}}
  {{#if sustained}}
  <div class="spell-result">
    <p>{{localize "SINLESS.Sustained.line" n=sum.successes}}</p>
    {{#each sustained}}
    {{#if applied}}<p class="reroll-note">{{localize "SINLESS.Sustained.appliedTo" name=name}}</p>
    {{else}}<button type="button" data-sinless-action="apply-sustained" data-target-uuid="{{uuid}}"><i class="fa-solid fa-wand-sparkles"></i> {{localize "SINLESS.Sustained.applyTo" name=name}}</button>{{/if}}
    {{/each}}
  </div>
  {{/if}}
  {{#if extra.spell}}
  <div class="spell-result">
    <p>{{#if extra.spell.force}}{{localize "SINLESS.Magic.force"}} {{extra.spell.force}} · {{/if}}<span class="{{#if extra.spell.lethal}}lethal{{/if}}">{{localize "SINLESS.Magic.drainLine" n=extra.spell.drain}} ({{#if extra.spell.lethal}}{{localize "SINLESS.Magic.lethal"}}{{else}}{{localize "SINLESS.Condition.stun"}}{{/if}})</span></p>
    {{#unless extra.spell.applied}}
    <button type="button" data-sinless-action="resist-drain"><i class="fa-solid fa-hand-sparkles"></i> {{localize "SINLESS.Magic.resistDrain"}}</button>
    {{else}}<p class="reroll-note">{{localize "SINLESS.Magic.drainTaken"}}</p>{{/unless}}
  </div>
  {{/if}}
  {{#if summon}}
  <p class="effect">{{localize (concat "SINLESS.Magic.summon." summon.outcome) n=summon.services needed=summon.needed}}</p>
  {{#if summon.canPlace}}<button type="button" data-sinless-action="place-spirit"><i class="fa-solid fa-ghost"></i> {{localize "SINLESS.Spirit.place"}}</button>{{/if}}
  {{#if extra.summon.placed}}<p class="reroll-note">{{localize "SINLESS.Spirit.placed"}}</p>{{/if}}
  {{/if}}
  {{#if vcrUsed}}<p class="reroll-note">{{localize "SINLESS.Rig.vcrUsed" n=vcrUsed}}</p>{{/if}}
  {{#if overdrive}}<p class="effect">{{localize "SINLESS.Rig.overdriveGain" n=overdrive.gain}}{{#if overdrive.inertia}} · {{localize "SINLESS.Rig.overdriveInertia"}}{{/if}}</p>{{/if}}
  {{#if ram}}
  <p class="effect">{{#if extra.ram.battleRam}}{{localize "SINLESS.Rig.battleRamNote"}} · {{/if}}{{#if (eq ram.selfDamage null)}}{{localize "SINLESS.Rig.ramSelfUnknown"}}{{else}}{{localize "SINLESS.Rig.ramSelf" n=ram.selfDamage}}{{/if}}</p>
  {{#if ram.selfDamage}}{{#unless ram.applied}}<button type="button" data-sinless-action="apply-ram-self"><i class="fa-solid fa-car-burst"></i> {{localize "SINLESS.Rig.applyRamSelf" n=ram.selfDamage}}</button>{{/unless}}{{/if}}
  {{/if}}
  {{#if mcpUsed}}<p class="reroll-note">{{localize "SINLESS.Grid.mcpUsed" n=mcpUsed}}</p>{{/if}}
  {{#if extra.effect}}<p class="effect">{{extra.effect}}</p>{{/if}}
  {{#if grid}}
  <div class="grid-result">
    {{#if grid.nan}}<p>{{localize "SINLESS.Grid.influenceGain" n=grid.gain}}</p>{{/if}}
    <p>{{localize "SINLESS.Grid.alertRaise" n=grid.alert}}{{#if extra.alertNote}} <span class="formula">({{extra.alertNote}})</span>{{/if}}{{#if extra.shadow}} <span class="formula">{{localize "SINLESS.Grid.shadowReduced" n=extra.shadow}}</span>{{/if}}{{#if extra.sensor}} <span class="formula">{{localize "SINLESS.Digital.sensorAdded" n=extra.sensor}}</span>{{/if}}</p>
    {{#if extra.alertApplied}}<p class="effect">{{localize "SINLESS.Grid.alertNow" n=extra.alertNow}}</p>{{/if}}
    {{#if grid.nan}}{{#unless extra.influenceApplied}}{{#if grid.gain}}
    <button type="button" data-sinless-action="apply-influence"><i class="fa-solid fa-tower-broadcast"></i> {{localize "SINLESS.Grid.applyInfluence" n=grid.gain}}</button>
    {{/if}}{{/unless}}{{/if}}
    {{#unless extra.alertApplied}}{{#if grid.alert}}
    <button type="button" data-sinless-action="apply-alert"><i class="fa-solid fa-bell"></i> {{localize "SINLESS.Grid.applyAlert" n=grid.alert}}</button>
    {{/if}}{{/unless}}
  </div>
  {{/if}}
  {{#if extra.chase}}
  <p class="effect{{#unless chase.success}} warn{{/unless}}">{{localize (concat "SINLESS.Chase.action." extra.chase.action)}}{{#if extra.chase.targetName}} ({{extra.chase.targetName}}){{/if}}: {{#if chase.success}}{{localize "SINLESS.Chase.success"}}{{else}}{{localize "SINLESS.Chase.failure"}}{{/if}}</p>
  {{#if extra.chase.applied}}<p class="effect">{{localize "SINLESS.Chase.applied"}}</p>
  {{else if chase.applicable}}<button type="button" data-sinless-action="apply-chase"><i class="fa-solid fa-car-side"></i> {{localize "SINLESS.Chase.apply"}}</button>{{/if}}
  {{/if}}
  {{#if extra.shadow}}
  <p class="effect">{{localize "SINLESS.Operation.shadowAlert" n=shadowAlert}}</p>
  {{#if extra.shadowApplied}}<p class="effect">{{localize "SINLESS.Grid.alertNow" n=extra.alertNow}}</p>
  {{else}}{{#if shadowAlert}}<button type="button" data-sinless-action="apply-shadow-alert"><i class="fa-solid fa-bell"></i> {{localize "SINLESS.Grid.applyAlert" n=shadowAlert}}</button>{{/if}}{{/if}}
  {{/if}}
  {{#if extra.overload}}
  {{#if overloadFailed}}
  <p class="effect warn">{{#if (eq extra.overload.track "physical")}}{{#if extra.overload.rounds includeZero=true}}{{localize "SINLESS.Overload.failPhysical" n=extra.overload.rounds}}{{else}}{{localize "SINLESS.Overload.failPhysicalNpc"}}{{/if}}{{else}}{{localize "SINLESS.Overload.failStun"}}{{/if}}</p>
  {{#if extra.overload.applied}}<p class="effect">{{localize "SINLESS.Overload.applied"}}</p>{{else}}
  <button type="button" data-sinless-action="apply-overload"><i class="fa-solid fa-bed"></i> {{localize "SINLESS.Overload.apply"}}</button>{{/if}}
  {{else}}
  <p class="effect">{{localize "SINLESS.Overload.pass"}}</p>
  {{/if}}
  {{/if}}
  {{#if injury}}
  <p class="effect{{#unless (eq injury.result "none")}} warn{{/unless}}">{{localize (concat "SINLESS.Injury.result." injury.result) attribute=(localize injury.attributeLabel)}}</p>
  {{#if (eq injury.result "organ")}}{{#if injury.attributeLabel}}
  {{#if extra.injury.applied}}<p class="effect">{{localize "SINLESS.Injury.applied"}}</p>{{else}}
  <button type="button" data-sinless-action="apply-organ"><i class="fa-solid fa-lungs"></i> {{localize "SINLESS.Injury.apply" attribute=(localize injury.attributeLabel)}}</button>{{/if}}
  {{/if}}{{/if}}
  {{/if}}
  {{#if extra.heatRaised}}<p class="effect warn">{{localize "SINLESS.Card.heatRaised" heat=extra.heatRaised}}</p>{{/if}}
  {{#if shrink}}
  <div class="grid-result">
    <p class="effect">{{localize "SINLESS.Digital.shrinkLine" n=shrink.loss}}</p>
    {{#each shrink.targets}}
    {{#if applied}}<p class="reroll-note">{{localize "SINLESS.Digital.shrinkApplied" name=name}}</p>
    {{else}}<button type="button" data-sinless-action="apply-shrink" data-target-uuid="{{uuid}}"><i class="fa-solid fa-compress"></i> {{localize "SINLESS.Digital.applyShrink" name=name n=../shrink.loss}}</button>{{/if}}
    {{else}}<p class="reroll-note">{{localize "SINLESS.Digital.shrinkNoTarget"}}</p>
    {{/each}}
  </div>
  {{/if}}
  {{#if extra.weapon}}
  {{#if extra.digital}}
  <p class="weapon-line">{{localize (concat "SINLESS.Digital.line." extra.digital) damage=extra.damage rating=extra.rating ignore=extra.ignoreHardening}}</p>
  {{else}}
  <p class="weapon-line">
    {{#if extra.blast}}{{localize "SINLESS.Card.damageBlast" damage=extra.damage}}{{else}}{{localize "SINLESS.Card.damage" damage=extra.damage}}{{/if}}
    {{#if extra.magic}}{{#if extra.resistPool}}· {{localize "SINLESS.Magic.resistedBy" pool=(localize (concat "SINLESS.Pool." extra.resistPool))}}{{/if}}{{else}}· {{localize (concat "SINLESS.Armor." extra.armorType)}} · {{localize "SINLESS.Item.FIELDS.penetration.label"}} {{extra.penetration}}{{/if}}
    {{#if extra.stun}} · {{localize "SINLESS.Condition.stun"}}{{/if}}
    {{#if extra.damageFormula}}<span class="formula">({{extra.damageText}} → {{extra.damageFormula}})</span>{{/if}}
    {{#if extra.damageNote}}<span class="formula">+ {{extra.damageNote}}</span>{{/if}}
  </p>
  {{/if}}
  {{#if extra.recoil}}
  <p class="recoil-line">{{localize "SINLESS.Combat.recoilStatus" tokens=extra.recoil.tokens capacity=extra.recoil.capacity}}{{#if extra.recoil.gained}} (+{{extra.recoil.gained}}){{/if}}</p>
  {{#if extra.recoil.jammed}}<p class="effect warn">{{localize "SINLESS.Combat.recoilMiss"}}</p>{{/if}}
  {{/if}}
  {{#if canDefend}}
  <div class="defend">
    {{#each extra.targets}}
    <button type="button" data-sinless-action="defend" data-target-uuid="{{uuid}}"><i class="fa-solid fa-shield-halved"></i> {{localize "SINLESS.Card.defend" name=name}}</button>
    {{/each}}
    <button type="button" data-sinless-action="defend-selected"><i class="fa-solid fa-crosshairs"></i> {{localize "SINLESS.Card.defendSelected"}}</button>
  </div>
  {{/if}}
  {{/if}}
  {{#if canAddKismet}}
  <button type="button" data-sinless-action="kismet"><i class="fa-solid fa-dice-d6"></i> {{localize "SINLESS.Card.addKismet"}}</button>
  {{/if}}
</div>
